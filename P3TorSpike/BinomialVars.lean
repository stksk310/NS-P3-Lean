import P3TorSpike.BinomialInterface

noncomputable section
namespace NSP3.TorSpike

/-- The augmentation kernel is precisely the ideal generated by the actual four variables. -/
theorem polynomialAugmentation_ker (k : Type) [Field k] :
    RingHom.ker (polynomialAugmentation k).toRingHom =
      Ideal.span (Set.range (MvPolynomial.X : Fin 4 → PolynomialRing k)) := by
  classical
  ext p
  change polynomialAugmentation k p = 0 ↔ _
  rw [polynomialAugmentation_eq_constantCoeff, MvPolynomial.constantCoeff_eq]
  have hh := MvPolynomial.mem_ideal_span_X_image (x := p) (s := Set.univ)
  rw [Set.image_univ] at hh
  rw [hh]
  constructor
  · intro hp d hd
    have hdn : d ≠ 0 := by
      intro hz
      subst d
      exact (MvPolynomial.mem_support_iff.mp hd) hp
    have hn : ∃ i, d i ≠ 0 := by
      by_contra h
      apply hdn
      ext i
      exact not_not.mp (not_exists.mp h i)
    obtain ⟨i, hi⟩ := hn
    exact ⟨i, trivial, hi⟩
  · intro hp
    by_contra hz
    have hs : (0 : Fin 4 →₀ ℕ) ∈ p.support := MvPolynomial.mem_support_iff.mpr hz
    obtain ⟨i, _, hi⟩ := hp 0 hs
    exact hi rfl

/-- A direct ideal-product form of the defining relation-conormal quotient. -/
theorem relationConormal_mk_eq_zero_vars (k : Type) [Field k] (m a b c : ℕ)
    (x : relationKernel k m a b c) :
    (Submodule.Quotient.mk x : relationConormal k m a b c) = 0 ↔
      (x : PolynomialRing k) ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 4 → PolynomialRing k)) *
        relationKernel k m a b c := by
  rw [relationConormal_mk_eq_zero, polynomialAugmentation_ker]

end NSP3.TorSpike
