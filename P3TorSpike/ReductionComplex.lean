import P3TorSpike.HomologyDimension
import Mathlib.Algebra.Algebra.Bilinear
import Mathlib.Data.Fin.VecNotation
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Ring

noncomputable section
namespace NSP3.TorSpike
open CategoryTheory

section ThreeVariable
variable (k A : Type) [Field k] [CommRing A] [Algebra k A]

/-- The three-variable Koszul differential in degree one. -/
def threeD1 (u : Fin 3 → A) : (Fin 3 → A) →ₗ[k] A :=
  ((LinearMap.mul k A (u 0)).comp (LinearMap.proj 0)) +
  ((LinearMap.mul k A (u 1)).comp (LinearMap.proj 1)) +
  ((LinearMap.mul k A (u 2)).comp (LinearMap.proj 2))

/-- Degree-two coordinates are the ordered pairs 01, 02, 12. -/
def threeD2 (u : Fin 3 → A) : (Fin 3 → A) →ₗ[k] (Fin 3 → A) :=
  LinearMap.pi ![
    -((LinearMap.mul k A (u 1)).comp (LinearMap.proj 0)) -
       ((LinearMap.mul k A (u 2)).comp (LinearMap.proj 1)),
    ((LinearMap.mul k A (u 0)).comp (LinearMap.proj 0)) -
       ((LinearMap.mul k A (u 2)).comp (LinearMap.proj 2)),
    ((LinearMap.mul k A (u 0)).comp (LinearMap.proj 1)) +
       ((LinearMap.mul k A (u 1)).comp (LinearMap.proj 2))]

def threeD3 (u : Fin 3 → A) : A →ₗ[k] (Fin 3 → A) :=
  LinearMap.pi ![LinearMap.mul k A (u 2),
    -(LinearMap.mul k A (u 1)), LinearMap.mul k A (u 0)]

@[simp] theorem threeD1_apply (u : Fin 3 → A) (v : Fin 3 → A) :
    threeD1 k A u v = u 0 * v 0 + u 1 * v 1 + u 2 * v 2 := rfl

@[simp] theorem threeD2_apply (u : Fin 3 → A) (v : Fin 3 → A) :
    threeD2 k A u v = ![-(u 1 * v 0) - u 2 * v 1,
      u 0 * v 0 - u 2 * v 2, u 0 * v 1 + u 1 * v 2] := by
  funext i; fin_cases i <;> rfl

@[simp] theorem threeD3_apply (u : Fin 3 → A) (v : A) :
    threeD3 k A u v = ![u 2 * v, -(u 1 * v), u 0 * v] := by
  funext i; fin_cases i <;> rfl

/-- The degree-zero boundaries form the ideal generated by the three elements. -/
def threeImageIdeal (u : Fin 3 → A) : Ideal A where
  carrier := Set.range (threeD1 k A u)
  zero_mem' := ⟨0, map_zero _⟩
  add_mem' := by
    rintro _ _ ⟨v, rfl⟩ ⟨w, rfl⟩
    exact ⟨v + w, map_add _ _ _⟩
  smul_mem' := by
    rintro r _ ⟨v, rfl⟩
    refine ⟨fun i => r * v i, ?_⟩
    change u 0 * (r * v 0) + u 1 * (r * v 1) + u 2 * (r * v 2) =
      r * (u 0 * v 0 + u 1 * v 1 + u 2 * v 2)
    ring

theorem threeGenerator_mem_image (u : Fin 3 → A) (i : Fin 3) :
    u i ∈ threeImageIdeal k A u := by
  fin_cases i
  · exact ⟨![1, 0, 0], by simp⟩
  · exact ⟨![0, 1, 0], by simp⟩
  · exact ⟨![0, 0, 1], by simp⟩

theorem threeImageIdeal_restrictScalars (u : Fin 3 → A) :
    (threeImageIdeal k A u).restrictScalars k = LinearMap.range (threeD1 k A u) := rfl

theorem threeD1_comp_threeD2 (u : Fin 3 → A) :
    (threeD1 k A u).comp (threeD2 k A u) = 0 := by
  ext v
  simp [threeD1_apply, threeD2_apply]
  ring

theorem threeD2_comp_threeD3 (u : Fin 3 → A) :
    (threeD2 k A u).comp (threeD3 k A u) = 0 := by
  ext v i
  fin_cases i <;> simp [threeD2_apply, threeD3_apply] <;> ring

def threeH1Complex (u : Fin 3 → A) : ShortComplex (ModuleCat.{0} k) :=
  ShortComplex.moduleCatMk (threeD2 k A u) (threeD1 k A u)
    (threeD1_comp_threeD2 k A u)

def threeH2Complex (u : Fin 3 → A) : ShortComplex (ModuleCat.{0} k) :=
  ShortComplex.moduleCatMk (threeD3 k A u) (threeD2 k A u)
    (threeD2_comp_threeD3 k A u)

/-- The degree-three cycles are the actual common annihilator. -/
theorem mem_threeD3_ker (u : Fin 3 → A) (v : A) :
    v ∈ LinearMap.ker (threeD3 k A u) ↔ ∀ i : Fin 3, u i * v = 0 := by
  change threeD3 k A u v = 0 ↔ _
  constructor
  · intro h i
    fin_cases i
    · exact congrFun h 2
    · have h₁ := congrFun h 1
      simpa using h₁
    · exact congrFun h 0
  · intro h
    ext i
    fin_cases i <;> simp [h]

/-- Euler's identity for genuine homology of the finite reduced complex. -/
theorem three_euler [Module.Finite k A] (u : Fin 3 → A) :
    Module.finrank k (A ⧸ LinearMap.range (threeD1 k A u)) +
        Module.finrank k (threeH2Complex k A u).homology =
      Module.finrank k (threeH1Complex k A u).homology +
        Module.finrank k (LinearMap.ker (threeD3 k A u)) := by
  letI : Module.Finite k (threeH1Complex k A u).X₁ :=
    (inferInstance : Module.Finite k (Fin 3 → A))
  letI : Module.Finite k (threeH1Complex k A u).X₂ :=
    (inferInstance : Module.Finite k (Fin 3 → A))
  letI : Module.Finite k (threeH2Complex k A u).X₁ :=
    (inferInstance : Module.Finite k A)
  letI : Module.Finite k (threeH2Complex k A u).X₂ :=
    (inferInstance : Module.Finite k (Fin 3 → A))
  have h₀ := (LinearMap.range (threeD1 k A u)).finrank_quotient_add_finrank
  have h₁ := shortComplex_homology_finrank k (threeH1Complex k A u)
  have h₂ := shortComplex_homology_finrank k (threeH2Complex k A u)
  have h₃ := (threeD3 k A u).finrank_range_add_finrank_ker
  change Module.finrank k (threeH1Complex k A u).homology +
    Module.finrank k (LinearMap.range (threeD2 k A u)) +
    Module.finrank k (LinearMap.range (threeD1 k A u)) =
    Module.finrank k (Fin 3 → A) at h₁
  change Module.finrank k (threeH2Complex k A u).homology +
    Module.finrank k (LinearMap.range (threeD3 k A u)) +
    Module.finrank k (LinearMap.range (threeD2 k A u)) =
    Module.finrank k (Fin 3 → A) at h₂
  omega

theorem threeH1_finite [Module.Finite k A] (u : Fin 3 → A) :
    Module.Finite k (threeH1Complex k A u).homology := by
  letI : Module.Finite k (threeH1Complex k A u).X₂ :=
    (inferInstance : Module.Finite k (Fin 3 → A))
  exact shortComplex_homology_finite k (threeH1Complex k A u)

theorem threeH2_finite [Module.Finite k A] (u : Fin 3 → A) :
    Module.Finite k (threeH2Complex k A u).homology := by
  letI : Module.Finite k (threeH2Complex k A u).X₂ :=
    (inferInstance : Module.Finite k (Fin 3 → A))
  exact shortComplex_homology_finite k (threeH2Complex k A u)

end ThreeVariable
end NSP3.TorSpike
