import NSP3.AtomFactorization

namespace NSP3

/-- Least additive congruence generated by finite edges, on any additive type. -/
inductive GeneratedAddRel {A : Type*} [Add A] (R : Finset (A × A)) : A → A → Prop
  | edge {u v} : (u,v) ∈ R → GeneratedAddRel R u v
  | refl (u) : GeneratedAddRel R u u
  | symm {u v} : GeneratedAddRel R u v → GeneratedAddRel R v u
  | trans {u v w} : GeneratedAddRel R u v → GeneratedAddRel R v w → GeneratedAddRel R u w
  | context {u v} : GeneratedAddRel R u v → (d : A) → GeneratedAddRel R (u+d) (v+d)

def mapRelations {A B : Type*} [Add A] [Add B] (e : A ≃+ B) (R : Finset (A × A)) :
    Finset (B × B) := R.map (e.toEquiv.prodCongr e.toEquiv).toEmbedding

theorem mapRelations_card {A B : Type*} [Add A] [Add B] (e : A ≃+ B)
    (R : Finset (A × A)) : (mapRelations e R).card = R.card := Finset.card_map _

theorem mapRelations_symm {A B : Type*} [Add A] [Add B] (e : A ≃+ B)
    (R : Finset (A × A)) : mapRelations e.symm (mapRelations e R) = R := by
  classical
  ext p
  simp only [mapRelations, Finset.mem_map, Equiv.coe_toEmbedding, Equiv.prodCongr_apply]
  constructor
  · rintro ⟨q,⟨r,hr,rfl⟩,he⟩
    rcases r with ⟨r₁,r₂⟩
    change (e.symm (e r₁),e.symm (e r₂)) = p at he
    simp only [AddEquiv.symm_apply_apply] at he
    exact he ▸ hr
  · intro hp
    exact ⟨(e p.1,e p.2),⟨p,hp,rfl⟩,by simp⟩

theorem generatedAddRel_map {A B : Type*} [Add A] [Add B] (e : A ≃+ B)
    (R : Finset (A × A)) {u v : A} (h : GeneratedAddRel R u v) :
    GeneratedAddRel (mapRelations e R) (e u) (e v) := by
  induction h with
  | edge he => exact .edge (Finset.mem_map.mpr ⟨_,he,rfl⟩)
  | refl u => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂
  | context _ d ih => simpa only [map_add] using GeneratedAddRel.context ih (e d)

theorem generatedAddRel_map_iff {A B : Type*} [Add A] [Add B] (e : A ≃+ B)
    (R : Finset (A × A)) (u v : A) :
    GeneratedAddRel (mapRelations e R) (e u) (e v) ↔ GeneratedAddRel R u v := by
  constructor
  · intro h
    have hh := generatedAddRel_map e.symm _ h
    simpa only [mapRelations_symm, AddEquiv.symm_apply_apply] using hh
  · exact generatedAddRel_map e R

theorem generatedAddRel_four_iff (R : Finset (Fact4 × Fact4)) (u v : Fact4) :
    GeneratedAddRel R u v ↔ PresentationRel R u v := by
  constructor <;> intro h
  · induction h with
    | edge he => exact .edge he
    | refl u => exact .refl u
    | symm _ ih => exact .symm ih
    | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂
    | context _ d ih => exact .context ih d
  · induction h with
    | edge he => exact .edge he
    | refl u => exact .refl u
    | symm _ ih => exact .symm ih
    | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂
    | context _ d ih => exact .context ih d

end NSP3
