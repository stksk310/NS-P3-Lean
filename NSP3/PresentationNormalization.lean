import NSP3.PresentationBoundary

namespace NSP3

/-- Well-founded weighted-lex descent, with no bound on the number of rewrites. -/
theorem boundaryRelations_normalize (m a b c : ℕ) (hm : 0 < m)
    (hgcd : Nat.gcd m (Nat.gcd a (Nat.gcd b c)) = 1) (u : Fact4) :
    ∃ l : ℕ, ∃ q ∈ aperyStandardSet m a b c hm hgcd,
      PresentationRel (boundaryRelations m a b c hm hgcd) u (l,q) := by
  classical
  have wf : WellFounded (fun p q : Point3 => aperyKey a b c p < aperyKey a b c q) :=
    InvImage.wf (aperyKey a b c) wellFounded_lt
  have hall : ∀ p : Point3, ∀ k : ℕ,
      ∃ l : ℕ, ∃ q ∈ aperyStandardSet m a b c hm hgcd,
        PresentationRel (boundaryRelations m a b c hm hgcd) (k,p) (l,q) := by
    intro p
    induction p using wf.induction with
    | h p ih =>
      intro k
      by_cases hp : p ∈ aperyStandardSet m a b c hm hgcd
      · exact ⟨k,p,hp,PresentationRel.refl _⟩
      · obtain ⟨bp,hb,hbp⟩ := presentation_border_exists_le _ p hp
        obtain ⟨d,hd⟩ := presentation_add_offset hbp
        let border : PresentationBorder m a b c hm hgcd := ⟨bp,hb⟩
        let v := boundaryReplacement m a b c hm hgcd border
        have hv := boundaryReplacement_spec m a b c hm hgcd border
        have hlt : aperyKey a b c (v.2+d) < aperyKey a b c p := by
          rw [← hd, aperyKey_add, aperyKey_add]
          have hstrict : aperyKey a b c v.2 < aperyKey a b c bp := hv.2.2
          exact (add_lt_add_iff_right (aperyKey a b c d)).mpr hstrict
        obtain ⟨l,q,hq,hrel⟩ := ih (v.2+d) hlt (v.1+k)
        have hedge := PresentationRel.edge (boundaryRelations_edge_mem m a b c hm hgcd border)
        have hc := PresentationRel.context hedge (k,d)
        change PresentationRel (boundaryRelations m a b c hm hgcd)
          (0+k,bp+d) (v.1+k,v.2+d) at hc
        simp only [zero_add,hd] at hc
        exact ⟨l,q,hq,PresentationRel.trans hc hrel⟩
  exact hall u.2 u.1

/-- The canonical coordinates and the remaining m coefficient are both unique. -/
theorem factorNormalForm_unique (m a b c : ℕ) (hm : 0 < m)
    (hgcd : Nat.gcd m (Nat.gcd a (Nat.gcd b c)) = 1)
    {k l : ℕ} {p q : Point3}
    (hp : p ∈ aperyStandardSet m a b c hm hgcd)
    (hq : q ∈ aperyStandardSet m a b c hm hgcd)
    (he : factorWeight m a b c (k,p) = factorWeight m a b c (l,q)) :
    (k,p) = (l,q) := by
  have hz := congrArg (fun n : ℕ => (n : ZMod m)) he
  simp only [factorWeight,Nat.cast_add,Nat.cast_mul,ZMod.natCast_self,mul_zero,zero_add,
    aperyWeight_cast] at hz
  have hpq : p=q := aperyCanonical_unique m a b c
    ((mem_aperyStandardSet m a b c hm hgcd p).mp hp)
    ((mem_aperyStandardSet m a b c hm hgcd q).mp hq) hz
  subst q
  have hkl : k=l := by
    simp only [factorWeight] at he
    have hmul : k*m=l*m := Nat.add_right_cancel he
    exact Nat.eq_of_mul_eq_mul_right hm hmul
  subst l
  rfl

/-- The true numeric kernel is generated by the finite canonical border edges. -/
theorem boundaryRelations_generate (m a b c : ℕ) (hm : 0 < m)
    (hgcd : Nat.gcd m (Nat.gcd a (Nat.gcd b c)) = 1) (u v : Fact4) :
    PresentationRel (boundaryRelations m a b c hm hgcd) u v ↔
      factorWeight m a b c u = factorWeight m a b c v := by
  have hs : ∀ {s t : Fact4}, PresentationRel (boundaryRelations m a b c hm hgcd) s t →
      factorWeight m a b c s = factorWeight m a b c t :=
    fun h => presentationRel_sound m a b c _ (boundaryRelations_sound m a b c hm hgcd) h
  constructor
  · exact hs
  · intro he
    obtain ⟨k,p,hp,hu⟩ := boundaryRelations_normalize m a b c hm hgcd u
    obtain ⟨l,q,hq,hv⟩ := boundaryRelations_normalize m a b c hm hgcd v
    have hn : factorWeight m a b c (k,p) = factorWeight m a b c (l,q) :=
      (hs hu).symm.trans (he.trans (hs hv))
    have heq := factorNormalForm_unique m a b c hm hgcd hp hq hn
    rw [← heq] at hv
    exact PresentationRel.trans hu (PresentationRel.symm hv)

end NSP3
