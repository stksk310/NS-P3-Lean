import Mathlib

/-!
Finite sets of indispensable directed edges have equal cardinality whenever they generate
all pairs modulo a fixed base relation. The proof uses edge differences evaluated on
rational-valued base potentials. A component indicator separates every indispensable edge
from the span of all the others. Thus loops and reverse duplicates are automatically excluded.
No finiteness assumption on the vertex type is necessary.
-/
namespace CommonCard

variable {V : Type*}

/-- Equivalence generated by the base relation and a finite set of directed pairs. -/
def joined (E : V → V → Prop) (R : Finset (V × V)) : V → V → Prop :=
  Relation.EqvGen (fun a b => E a b ∨ (a, b) ∈ R)

/-- Potentials constant along every base edge. -/
def BasePotential (E : V → V → Prop) :=
  {f : V → ℚ // ∀ a b, E a b → f a = f b}

/-- The difference of endpoint evaluations, as a vector in a rational function space. -/
def edgeVector (E : V → V → Prop) (e : V × V) : BasePotential E → ℚ :=
  fun f => f.val e.1 - f.val e.2

/-- The finite edge span. -/
def edgeSpan (E : V → V → Prop) (R : Finset (V × V)) :
    Submodule ℚ (BasePotential E → ℚ) :=
  Submodule.span ℚ (edgeVector E '' (R : Set (V × V)))

lemma edgeVector_mem_span_of_joined (E : V → V → Prop) (R : Finset (V × V))
    {x y : V} (h : joined E R x y) : edgeVector E (x, y) ∈ edgeSpan E R := by
  induction h with
  | rel a b hab =>
      rcases hab with hab | hab
      · have hz : edgeVector E (a, b) = 0 := by
          funext f
          exact sub_eq_zero.mpr (f.property a b hab)
        rw [hz]
        exact Submodule.zero_mem _
      · exact Submodule.subset_span ⟨(a,b), hab, rfl⟩
  | refl a =>
      have hz : edgeVector E (a, a) = 0 := by funext f; simp [edgeVector]
      rw [hz]
      exact Submodule.zero_mem _
  | symm a b hab ih =>
      have hn : edgeVector E (b, a) = -edgeVector E (a, b) := by
        funext f; simp [edgeVector]
      rw [hn]
      exact Submodule.neg_mem _ ih
  | trans a b c hab hbc ihab ihbc =>
      have ha : edgeVector E (a, c) = edgeVector E (a, b) + edgeVector E (b, c) := by
        funext f; simp [edgeVector]
      rw [ha]
      exact Submodule.add_mem _ ihab ihbc

/-- A component cut is a rational base potential. -/
noncomputable def componentPotential (E : V → V → Prop) (R : Finset (V × V)) (x : V) :
    BasePotential E := by
  classical
  refine ⟨fun y => if joined E R x y then 1 else 0, ?_⟩
  intro a b hab
  have hab' : joined E R a b := .rel a b (Or.inl hab)
  have hi : joined E R x a ↔ joined E R x b :=
    ⟨fun h => .trans x a b h hab', fun h => .trans x b a h (.symm a b hab')⟩
  simp only [hi]

lemma componentPotential_eq_of_joined (E : V → V → Prop) (R : Finset (V × V))
    (x : V) {a b : V} (hab : joined E R a b) :
    (componentPotential E R x).val a = (componentPotential E R x).val b := by
  classical
  have hi : joined E R x a ↔ joined E R x b :=
    ⟨fun h => .trans x a b h hab, fun h => .trans x b a h (.symm a b hab)⟩
  simp [componentPotential, hi]

lemma edgeVector_not_mem_span_of_not_joined (E : V → V → Prop) (R : Finset (V × V))
    {x y : V} (h : ¬ joined E R x y) : edgeVector E (x,y) ∉ edgeSpan E R := by
  classical
  intro hm
  let f := componentPotential E R x
  have hz : ∀ z ∈ edgeSpan E R, z f = 0 := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
        rcases hz with ⟨⟨a,b⟩, hab, rfl⟩
        exact sub_eq_zero.mpr (componentPotential_eq_of_joined E R x
          (Relation.EqvGen.rel a b (Or.inr hab)))
    | zero => rfl
    | add z w hz hw iz iw => simp [iz, iw]
    | smul c z hz iz => simp [iz]
  have hone : edgeVector E (x,y) f = 1 := by
    have hx : joined E R x x := .refl x
    simp [edgeVector, f, componentPotential, h, hx]
  have := hz _ hm
  rw [hone] at this
  norm_num at this

lemma edgeVectors_linearIndependent [DecidableEq V] (E : V → V → Prop)
    (R : Finset (V × V))
    (hi : ∀ e ∈ R, ¬ joined E (R.erase e) e.1 e.2) :
    LinearIndependent ℚ (fun e : R => edgeVector E e.val) := by
  rw [linearIndependent_iff_notMem_span]
  intro e hm
  apply edgeVector_not_mem_span_of_not_joined E (R.erase e.val) (hi e.val e.property)
  apply (Submodule.span_mono ?_) hm
  rintro _ ⟨f, hf, rfl⟩
  refine ⟨f.val, ?_, rfl⟩
  simp only [Finset.mem_coe, Finset.mem_erase]
  refine ⟨?_, f.property⟩
  intro he
  have : f = e := Subtype.ext he
  exact hf.2 (by simpa [this])

lemma edgeSpan_eq_span_range (E : V → V → Prop) (R : Finset (V × V)) :
    edgeSpan E R = Submodule.span ℚ (Set.range (fun e : R => edgeVector E e.val)) := by
  unfold edgeSpan
  apply congrArg (Submodule.span ℚ)
  ext z
  constructor
  · rintro ⟨e, he, rfl⟩
    exact ⟨⟨e, he⟩, rfl⟩
  · rintro ⟨e, rfl⟩
    exact ⟨e.val, e.property, rfl⟩

/-- Main generic API. Indispensability handles self edges and both orientations without
extra graph assumptions. This theorem also works for infinite or empty vertex types. -/
theorem relative_card_eq_of_mutual [DecidableEq V] (E : V → V → Prop) (R T : Finset (V × V))
    (hR : ∀ e ∈ T, joined E R e.1 e.2) (hT : ∀ e ∈ R, joined E T e.1 e.2)
    (iR : ∀ e ∈ R, ¬ joined E (R.erase e) e.1 e.2)
    (iT : ∀ e ∈ T, ¬ joined E (T.erase e) e.1 e.2) : R.card = T.card := by
  have hs : edgeSpan E R = edgeSpan E T := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨⟨a,b⟩, he, rfl⟩
      exact edgeVector_mem_span_of_joined E T (hT (a,b) he)
    · apply Submodule.span_le.mpr
      rintro _ ⟨⟨a,b⟩, he, rfl⟩
      exact edgeVector_mem_span_of_joined E R (hR (a,b) he)
  have hrankR : Module.finrank ℚ (edgeSpan E R) = R.card := by
    rw [edgeSpan_eq_span_range]
    simpa using finrank_span_eq_card (edgeVectors_linearIndependent E R iR)
  have hrankT : Module.finrank ℚ (edgeSpan E T) = T.card := by
    rw [edgeSpan_eq_span_range]
    simpa using finrank_span_eq_card (edgeVectors_linearIndependent E T iT)
  rw [← hrankR, ← hrankT, hs]

/-- Connected specialization of `relative_card_eq_of_mutual`. -/
theorem relative_card_eq [DecidableEq V] (E : V → V → Prop) (R T : Finset (V × V))
    (hR : ∀ x y, joined E R x y) (hT : ∀ x y, joined E T x y)
    (iR : ∀ e ∈ R, ¬ joined E (R.erase e) e.1 e.2)
    (iT : ∀ e ∈ T, ¬ joined E (T.erase e) e.1 e.2) : R.card = T.card :=
  relative_card_eq_of_mutual E R T (fun e _ => hR e.1 e.2)
    (fun e _ => hT e.1 e.2) iR iT

end CommonCard




