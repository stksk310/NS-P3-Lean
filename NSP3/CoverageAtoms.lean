import NSP3.MinimalGeneratorClass

namespace NSP3.Coverage

/-- A cofinite carrier contains every natural number above a positive threshold. -/
theorem cofinite_tail (S : AddSubmonoid ℕ) (hcof : ((S : Set ℕ)ᶜ).Finite) :
    ∃ C : ℕ, 0 < C ∧ ∀ n : ℕ, C ≤ n → n ∈ S := by
  obtain ⟨B, hB⟩ := hcof.bddAbove
  refine ⟨B + 1, by omega, ?_⟩
  intro n hn
  by_contra hnot
  have hb : n ≤ B := hB hnot
  omega

/-- The least positive carrier element is additively indecomposable. -/
theorem multiplicity_atom (S : AddSubmonoid ℕ) {m : ℕ}
    (hm : IsSemigroupMultiplicity (S : Set ℕ) m) :
    SemigroupAtom (S : Set ℕ) m := by
  refine ⟨hm.1, hm.2.1, ?_⟩
  intro x hx y hy he
  by_cases hx0 : x = 0
  · exact Or.inl hx0
  by_cases hy0 : y = 0
  · exact Or.inr hy0
  have hmx := hm.2.2 x hx (by omega)
  have hmy := hm.2.2 y hy (by omega)
  have hmpos := hm.2.1
  omega

/-- An atom cannot be a positive carrier element plus an element of the tail. -/
theorem atom_lt_tail_add (S : AddSubmonoid ℕ) {C m n : ℕ}
    (hC : 0 < C) (htail : ∀ n : ℕ, C ≤ n → n ∈ S)
    (hm : m ∈ S) (hmpos : 0 < m)
    (hn : SemigroupAtom (S : Set ℕ) n) : n < C + m := by
  by_contra hnot
  have hsub : C ≤ n - m := by omega
  have hmem : n - m ∈ S := htail (n-m) hsub
  have he : n = m + (n-m) := by omega
  rcases hn.2.2 m hm (n-m) hmem he with hz | hz <;> omega

/-- Cofiniteness and a positive carrier element bound the intrinsic atom set. -/
theorem atoms_finite (S : AddSubmonoid ℕ) {m : ℕ}
    (hcof : ((S : Set ℕ)ᶜ).Finite)
    (hm : IsSemigroupMultiplicity (S : Set ℕ) m) :
    {n : ℕ | SemigroupAtom (S : Set ℕ) n}.Finite := by
  obtain ⟨C, hC, htail⟩ := cofinite_tail S hcof
  apply (Set.finite_Iio (C+m)).subset
  intro n hn
  exact atom_lt_tail_add S hC htail hm.1 hm.2.1 hn

/-- Cofiniteness alone makes the intrinsic atom set finite. -/
theorem atoms_finite_of_cofinite (S : AddSubmonoid ℕ)
    (hcof : ((S : Set ℕ)ᶜ).Finite) :
    {n : ℕ | SemigroupAtom (S : Set ℕ) n}.Finite := by
  obtain ⟨C, hC, htail⟩ := cofinite_tail S hcof
  apply (Set.finite_Iio (C+C)).subset
  intro n hn
  exact atom_lt_tail_add S hC htail (htail C (le_refl C)) hC hn

/-- Every natural-number additive submonoid is generated by its intrinsic atoms. -/
theorem atoms_generate (S T : AddSubmonoid ℕ)
    (h : ∀ n : ℕ, SemigroupAtom (S : Set ℕ) n → n ∈ T) : S ≤ T := by
  intro n hn
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hz : n = 0
    · subst n
      exact T.zero_mem
    by_cases ha : SemigroupAtom (S : Set ℕ) n
    · exact h n ha
    have hpos : 0 < n := by omega
    have hsplit : ∃ x ∈ S, ∃ y ∈ S, n = x+y ∧ x ≠ 0 ∧ y ≠ 0 := by
      by_contra hno
      apply ha
      refine ⟨hn, hpos, ?_⟩
      intro x hx y hy he
      by_contra hzero
      exact hno ⟨x, hx, y, hy, he, (fun hx0 => hzero (Or.inl hx0)),
        (fun hy0 => hzero (Or.inr hy0))⟩
    obtain ⟨x, hx, y, hy, he, hx0, hy0⟩ := hsplit
    have hxt : x ∈ T := ih x (by omega) hx
    have hyt : y ∈ T := ih y (by omega) hy
    rw [he]
    exact T.add_mem hxt hyt

end NSP3.Coverage

